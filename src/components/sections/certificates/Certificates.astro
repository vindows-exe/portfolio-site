---
import type { Certificate } from '@/types/certificate';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import Badge from '@/components/ui/Badge.astro';
import { t, type Locale } from '@/i18n';

export interface Props {
  items: Certificate[];
  locale?: Locale;
}

const { items, locale = 'en' } = Astro.props;
---

<Section id="certificates" title={t(locale, 'section.certificates')} description={t(locale, 'section.certificates.desc')} variant="alt">
  <Container>
    {items.length > 0 ? (
      <>
        <div class="space-y-4">
          {items.map((cert) => (
            <div class="flex items-start justify-between rounded-lg border border-border bg-surface p-4 border-l-2 border-accent/30">
              <div class="flex flex-col gap-1">
                <h3 class="text-base font-medium text-text-primary">
                  {cert.credentialUrl ? (
                    <a href={cert.credentialUrl} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">
                      {cert.name}
                    </a>
                  ) : (
                    cert.name
                  )}
                </h3>
                <p class="text-sm text-text-secondary font-mono">{cert.issuer}</p>
              </div>
              <div class="flex flex-col items-end gap-1 shrink-0">
                <Badge variant="default" size="sm">{cert.date}</Badge>
                {cert.expires && (
                  <span class="text-xs text-text-tertiary font-mono">{t(locale, 'certificates.expires')} {cert.expires}</span>
                )}
              </div>
            </div>
          ))}
        </div>
        <a
          href="/certificates"
          class="mt-8 inline-flex items-center gap-1 text-sm font-mono text-text-secondary hover:text-accent transition-colors"
        >
          {t(locale, 'certificates.viewAll')}
        </a>
      </>
    ) : (
      <p class="text-text-secondary font-mono text-sm">{t(locale, 'certificates.noCertificates')}</p>
    )}
  </Container>
</Section>
