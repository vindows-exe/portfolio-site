---
import type { SocialLink } from '@/types/social';
import Container from '@/components/ui/Container.astro';

export interface Props {
  name: string;
  handle: string;
  tagline: string;
  socials: SocialLink[];
}
---

<section id="hero" aria-labelledby="hero-heading" class="py-24 md:py-32">
  <Container>
    <div class="flex flex-col items-center text-center">
      <h1 id="hero-heading" class="text-hero font-bold text-text-primary tracking-tight">
        {Astro.props.name}
      </h1>
      <p class="mt-2 font-mono text-sm text-text-tertiary">
        <span aria-hidden="true">@</span>{Astro.props.handle}
      </p>
      <p class="mt-4 text-lg text-text-secondary max-w-xl">
        {Astro.props.tagline}
      </p>
      <nav aria-label="Social links" class="mt-8 flex items-center gap-6">
        {Astro.props.socials.map((social) => (
          <a
            href={social.url}
            class="font-mono text-sm text-text-tertiary hover:text-accent transition-colors"
            aria-label={social.label}
            target="_blank"
            rel="noopener noreferrer"
          >
            {social.name}
          </a>
        ))}
      </nav>
    </div>
  </Container>
</section>
