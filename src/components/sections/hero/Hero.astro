---
import type { SocialLink } from '@/types/social';
import Container from '@/components/ui/Container.astro';
import { t, type Locale } from '@/i18n';

export interface Props {
  name: string;
  handle: string;
  tagline: string;
  socials: SocialLink[];
  locale?: Locale;
}

const { name, handle, tagline, socials, locale = 'en' } = Astro.props;
---

<section
  id="hero"
  aria-labelledby="hero-heading"
  class="hero-grid py-28 md:py-40"
>
  <Container>
    <div class="flex flex-col items-center text-center">
      <h1 id="hero-heading" class="text-hero font-bold text-text-primary tracking-tight">
        {name}
      </h1>
      <p class="mt-2 font-mono text-sm text-text-tertiary">
        <span aria-hidden="true">@</span>{handle}
      </p>
      <p class="mt-4 text-lg text-text-secondary max-w-xl">
        {tagline}
      </p>
      <div class="mt-6 flex items-center gap-4 text-xs font-mono text-text-tertiary">
        <span>{t(locale, 'hero.experience')}</span>
        <span class="text-border-subtle" aria-hidden="true">|</span>
        <span>{t(locale, 'hero.techStack')}</span>
        <span class="text-border-subtle" aria-hidden="true">|</span>
        <span>{t(locale, 'hero.infra')}</span>
      </div>
      <nav aria-label="Social links" class="mt-8 flex items-center gap-6">
        {socials.map((social) => (
          <a
            href={social.url}
            class="font-mono text-sm text-text-tertiary hover:text-accent transition-colors"
            aria-label={social.label}
            target="_blank"
            rel="noopener noreferrer"
          >
            {social.name}
          </a>
        ))}
      </nav>
    </div>
  </Container>
</section>

<style>
  .hero-grid {
    background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
  }
  :root:not(.dark) .hero-grid {
    background-image: linear-gradient(rgba(0,0,0,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,0,0,0.03) 1px, transparent 1px);
  }
</style>
