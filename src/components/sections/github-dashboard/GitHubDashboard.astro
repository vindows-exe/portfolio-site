---
import type { GitHubStatsSnapshot } from '@/types/github';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import Card from '@/components/ui/Card.astro';
import { t, type Locale } from '@/i18n';

export interface Props {
  data: GitHubStatsSnapshot;
  locale?: Locale;
}

const { data, locale = 'en' } = Astro.props;
const isFallback = data.source === 'fallback';

const repoCount = data.repoStats.length;
const totalStars = data.repoStats.reduce((sum, r) => sum + r.stars, 0);

const langFrequency = new Map<string, number>();
for (const repo of data.repoStats) {
  if (repo.primaryLanguage) {
    langFrequency.set(repo.primaryLanguage, (langFrequency.get(repo.primaryLanguage) ?? 0) + 1);
  }
}
let topLanguage = 'N/A';
let topLangCount = 0;
for (const [lang, count] of langFrequency) {
  if (count > topLangCount) {
    topLanguage = lang;
    topLangCount = count;
  }
}

const pinnedNames = new Set(data.pinnedRepos.map((r) => r.name));
const extraPinnedRepos = data.pinnedRepos.filter((r) => !data.repoStats.some((s) => s.name === r.name));

const heatmapColors: Record<number, string> = {
  0: 'bg-surface-raised',
  1: 'bg-accent-subtle opacity-30',
  2: 'bg-accent-subtle opacity-50',
  3: 'bg-accent-subtle opacity-70',
  4: 'bg-accent',
};
---

<Section id="github" title={t(locale, 'section.github')} description={t(locale, 'section.github.desc')} variant="alt" padding="spacious">
  <Container>
    {isFallback && (
      <p class="mb-6 rounded-md border border-accent/30 bg-accent-subtle px-4 py-2 text-sm font-mono text-accent">
        {t(locale, 'github.unavailable')}
      </p>
    )}

    {repoCount > 0 && (
      <div class="grid grid-cols-3 gap-3 mb-8">
        <div class="rounded-lg border border-border bg-surface p-3 text-center">
          <span class="block text-xl font-bold text-accent font-mono">{repoCount}</span>
          <span class="text-xs text-text-tertiary font-mono">{t(locale, 'github.repositories')}</span>
        </div>
        <div class="rounded-lg border border-border bg-surface p-3 text-center">
          <span class="block text-xl font-bold text-accent font-mono">{totalStars}</span>
          <span class="text-xs text-text-tertiary font-mono">{t(locale, 'github.totalStars')}</span>
        </div>
        <div class="rounded-lg border border-border bg-surface p-3 text-center">
          <span class="block text-xl font-bold text-accent font-mono">{topLanguage}</span>
          <span class="text-xs text-text-tertiary font-mono">{t(locale, 'github.topLanguage')}</span>
        </div>
      </div>
    )}

    {data.contributionCalendar && (
      <div class="mb-10">
        <h3 class="mb-3 text-sm font-mono font-medium text-text-tertiary">
          {data.contributionCalendar.totalContributions} {locale === 'de' ? 'Beiträge im letzten Jahr' : 'contributions in the last year'}
        </h3>
        <div class="overflow-x-auto pb-2">
          <div
            class="grid gap-[3px]"
            style={{
              gridTemplateColumns: `repeat(${data.contributionCalendar.weeks.length}, 10px)`,
              gridTemplateRows: 'repeat(7, 10px)',
            }}
          >
            {data.contributionCalendar.weeks.map((week) =>
              week.days.map((day) => (
                <div
                  class={`rounded-sm ${heatmapColors[day.level]}`}
                  style={{ width: '10px', height: '10px' }}
                  title={`${day.date}: ${day.count} contributions`}
                  aria-label={`${day.date}: ${day.count} contributions`}
                ></div>
              ))
            )}
          </div>
        </div>
      </div>
    )}

    {(data.repoStats.length > 0 || extraPinnedRepos.length > 0) && (
      <div>
        <h3 class="mb-4 text-sm font-mono font-medium text-text-tertiary uppercase tracking-wider">Repositories</h3>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {data.repoStats.map((repo) => (
            <Card>
              <div class="flex items-start justify-between">
                <div class="min-w-0">
                  <div class="flex items-center gap-1.5">
                    {pinnedNames.has(repo.name) && (
                      <span class="inline-block h-2 w-2 rounded-full bg-accent shrink-0" aria-label="Pinned repository"></span>
                    )}
                    <a
                      href={repo.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-mono text-sm font-medium text-text-primary hover:text-accent transition-colors truncate block"
                    >
                      {repo.name}
                    </a>
                  </div>
                  {repo.description && (
                    <p class="mt-1 text-xs text-text-tertiary line-clamp-2">{repo.description}</p>
                  )}
                </div>
              </div>
              <div class="mt-3 flex items-center gap-4 text-xs text-text-tertiary">
                {repo.primaryLanguage && (
                  <span class="font-mono">{repo.primaryLanguage}</span>
                )}
                <span>&star; {repo.stars}</span>
                <span>fork {repo.forks}</span>
              </div>
            </Card>
          ))}
          {extraPinnedRepos.map((repo) => (
            <Card>
              <div class="flex items-start justify-between">
                <div class="min-w-0">
                  <div class="flex items-center gap-1.5">
                    <span class="inline-block h-2 w-2 rounded-full bg-accent shrink-0" aria-label="Pinned repository"></span>
                    <a
                      href={repo.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-mono text-sm font-medium text-text-primary hover:text-accent transition-colors"
                    >
                      {repo.name}
                    </a>
                  </div>
                  {repo.description && (
                    <p class="mt-1 text-xs text-text-tertiary">{repo.description}</p>
                  )}
                </div>
              </div>
              <div class="mt-3 flex items-center gap-4 text-xs text-text-tertiary">
                {repo.language && (
                  <span class="font-mono inline-flex items-center gap-1">
                    {repo.language.color ? (
                      <span class="inline-block h-2 w-2 rounded-full" style={{ backgroundColor: repo.language.color }}></span>
                    ) : (
                      <span class="inline-block h-2 w-2 rounded-full bg-border"></span>
                    )}
                    {repo.language.name}
                  </span>
                )}
                <span>&star; {repo.stars}</span>
                <span>fork {repo.forks}</span>
              </div>
            </Card>
          ))}
        </div>
      </div>
    )}
  </Container>
</Section>
