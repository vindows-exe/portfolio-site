---
import type { CollectionEntry } from 'astro:content';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import ProjectCard from './ProjectCard.astro';
import { t, type Locale } from '@/i18n';

export interface Props {
  projects: CollectionEntry<'projects'>[];
  locale?: Locale;
}

const { projects, locale = 'en' } = Astro.props;
---

<Section id="projects" title={t(locale, 'section.projects')} description={t(locale, 'section.projects.desc')} variant="alt" padding="spacious">
  <Container>
    <div class="space-y-8">
      {projects.length > 0 ? (
        projects.map((project) => (
          <ProjectCard
            slug={project.slug}
            title={project.data.title}
            problem={project.data.problem}
            solution={project.data.solution}
            stack={project.data.stack}
            kpis={project.data.kpis}
            repoUrl={project.data.repoUrl}
            requirementsUrl={project.data.requirementsUrl}
            architectureUrl={project.data.architectureUrl}
            featured={project.data.featured}
            locale={locale}
          />
        ))
      ) : (
        <p class="text-text-secondary font-mono text-sm">Projects coming soon.</p>
      )}
    </div>
  </Container>
</Section>
