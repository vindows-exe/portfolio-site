---
import type { CollectionEntry } from 'astro:content';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';

export interface Props {
  posts: CollectionEntry<'blog'>[];
}
---

<Section id="blog" title="Blog" description="thoughts on systems engineering">
  <Container>
    {Astro.props.posts.length > 0 ? (
      <>
        <div class="space-y-6">
          {Astro.props.posts.map((post) => (
            <a href={`/blog/${post.slug.replace(/^en\//, '')}`} class="block rounded-lg border border-border bg-surface p-6 transition-colors hover:border-accent/30 hover:bg-surface-raised group">
              <div class="flex flex-col gap-2">
                <div class="flex items-center gap-3 text-xs font-mono text-text-tertiary">
                  <time datetime={post.data.publishedAt.toISOString()}>
                    {post.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <span class="flex gap-1.5">
                      {post.data.tags.map((tag: string) => (
                        <span class="rounded bg-surface-raised px-1.5 py-0.5">{tag}</span>
                      ))}
                    </span>
                  )}
                </div>
                <h3 class="text-xl font-semibold text-text-primary group-hover:text-accent transition-colors">
                  {post.data.title}
                </h3>
                <p class="text-sm text-text-secondary leading-relaxed">{post.data.description}</p>
                <span class="mt-1 text-sm font-mono text-accent">
                  Read more &rarr;
                </span>
              </div>
            </a>
          ))}
        </div>
        <a
          href="/blog"
          class="mt-8 inline-flex items-center gap-1 text-sm font-mono text-text-secondary hover:text-accent transition-colors"
        >
          View all posts &rarr;
        </a>
      </>
    ) : (
      <p class="text-text-secondary font-mono text-sm">No posts yet.</p>
    )}
  </Container>
</Section>
