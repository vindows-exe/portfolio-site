---
import type { SkillCategoryGroup, SkillCategory } from '@/types/skill';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import TechBadge from './TechBadge.astro';
import { t, type Locale } from '@/i18n';

export interface Props {
  categories: SkillCategoryGroup[];
  locale?: Locale;
}

const { categories, locale = 'en' } = Astro.props;

const categoryKey: Record<SkillCategory, `category.${SkillCategory}`> = {
  language: 'category.language',
  framework: 'category.framework',
  infrastructure: 'category.infrastructure',
  tool: 'category.tool',
  methodology: 'category.methodology',
  'quality-assurance': 'category.quality-assurance',
};
---

<Section id="skills" title={t(locale, 'section.skills')} description={t(locale, 'section.skills.desc')} padding="spacious">
  <Container>
    <div class="space-y-10">
      {categories.map((group) => (
        <div class="rounded-lg border border-border bg-surface p-5">
          <h3 class="mb-4 text-sm font-mono font-semibold text-text-tertiary uppercase tracking-widest">
            {t(locale, categoryKey[group.category])}
          </h3>
          <div class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <TechBadge
                name={skill.name}
                category={skill.category}
                proficiency={skill.proficiency}
                href={skill.href}
              />
            ))}
          </div>
        </div>
      ))}
    </div>
  </Container>
</Section>
