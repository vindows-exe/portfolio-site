---
import type { SkillCategory } from '@/types/skill';

export interface Props {
  name: string;
  category: SkillCategory;
  icon?: string;
  proficiency?: 'core' | 'proficient' | 'familiar';
  href?: string;
}

const { name, proficiency, href } = Astro.props;

const badgeClass =
  proficiency === 'core'
    ? 'border-accent/40 bg-accent-subtle'
    : proficiency === 'familiar'
      ? 'border-border/50 opacity-60'
      : 'border-border';
---

<span
  class={`inline-flex items-center gap-1.5 rounded-md border bg-surface px-3 py-1.5 text-sm font-mono text-text-secondary transition-colors hover:border-border-subtle hover:text-text-primary ${badgeClass}`}
>
  {proficiency === 'core' && (
    <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent" aria-label="Core proficiency"></span>
  )}
  {href ? (
    <a href={href} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">{name}</a>
  ) : (
    name
  )}
</span>
