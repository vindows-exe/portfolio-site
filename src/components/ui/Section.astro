---
export interface Props {
  id: string;
  title?: string;
  description?: string;
  class?: string;
  variant?: 'default' | 'alt';
}

const { id, title, description, class: className, variant = 'default' } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-heading`} class={`py-16 md:py-24 ${variant === 'alt' ? 'bg-surface' : 'bg-canvas'} ${className ?? ''}`}>
  {title && (
    <div class="mb-12">
      <h2 id={`${id}-heading`} class="text-display font-semibold text-text-primary">{title}</h2>
      {description && (
        <div class="flex items-baseline gap-2">
          <span class="text-xs font-mono text-text-tertiary select-none">//</span>
          <span class="text-sm text-text-secondary">{description}</span>
        </div>
      )}
    </div>
  )}
  <slot />
</section>
