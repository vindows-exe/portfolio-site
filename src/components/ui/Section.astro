---
export interface Props {
  id: string;
  title?: string;
  description?: string;
  class?: string;
  variant?: 'default' | 'alt';
  padding?: 'default' | 'spacious';
}

const { id, title, description, class: className, variant = 'default', padding = 'default' } = Astro.props;

const paddingClass = padding === 'spacious' ? 'py-20 md:py-28' : 'py-16 md:py-24';
---

<section id={id} aria-labelledby={`${id}-heading`} class={`${paddingClass} ${variant === 'alt' ? 'bg-surface' : 'bg-canvas'} ${className ?? ''}`}>
  {title && (
    <div class="mx-auto mb-12 w-full max-w-shell px-4">
      <h2 id={`${id}-heading`} class="text-display font-medium tracking-tight text-text-primary">{title}</h2>
      {description && (
        <div class="flex items-baseline gap-2">
          <span class="text-xs font-mono text-text-tertiary select-none">//</span>
          <span class="text-sm text-text-secondary">{description}</span>
        </div>
      )}
    </div>
  )}
  <slot />
</section>
