---
export interface Props {
  variant?: 'primary' | 'ghost' | 'link';
  href?: string;
  class?: string;
}

const { variant = 'primary', href, class: className } = Astro.props;

const base = 'inline-flex items-center gap-2 text-sm font-mono transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-canvas';

const variants: Record<string, string> = {
  primary: 'px-4 py-2 rounded bg-accent text-black font-semibold hover:bg-accent-emphasis',
  ghost: 'px-3 py-2 rounded hover:bg-surface-raised text-text-secondary hover:text-text-primary',
  link: 'text-accent hover:text-accent-emphasis underline-offset-4 hover:underline',
};
---

{
  href ? (
    <a href={href} class={`${base} ${variants[variant]} ${className ?? ''}`}>
      <slot />
    </a>
  ) : (
    <button class={`${base} ${variants[variant]} ${className ?? ''}`}>
      <slot />
    </button>
  )
}
