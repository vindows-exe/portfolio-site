---
export interface Props {
  variant?: 'default' | 'accent' | 'success' | 'danger';
  size?: 'sm' | 'md';
  class?: string;
}

const { variant = 'default', size = 'sm', class: className } = Astro.props;

const sizeClasses: Record<string, string> = {
  sm: 'px-2 py-0.5 text-xs',
  md: 'px-3 py-1 text-sm',
};

const variantClasses: Record<string, string> = {
  default: 'bg-surface-raised text-text-secondary border border-border',
  accent: 'bg-accent-subtle text-accent border border-accent/30',
  success: 'bg-success/10 text-success border border-success/30',
  danger: 'bg-danger/10 text-danger border border-danger/30',
};
---

<span class={`inline-flex items-center font-mono font-medium rounded-full ${sizeClasses[size]} ${variantClasses[variant]} ${className ?? ''}`}>
  <slot />
</span>
