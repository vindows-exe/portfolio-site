<script is:inline>
  (function () {
    let stored = localStorage.getItem('lang');
    const path = window.location.pathname;
    if (!stored) {
      const browserLang = navigator.language || '';
      stored = browserLang.startsWith('de') ? 'de' : 'en';
      localStorage.setItem('lang', stored);
    }
    if (stored === 'de' && !path.startsWith('/de')) {
      window.location.replace('/de' + path);
    } else if (stored === 'en' && path.startsWith('/de')) {
      window.location.replace(path.replace(/^\/de/, '') || '/');
    }
  })();
</script>
