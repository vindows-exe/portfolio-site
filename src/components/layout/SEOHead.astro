---
export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  noIndex?: boolean;
  type?: 'website' | 'article';
  publishedDate?: string;
}

const {
  title,
  description,
  ogImage,
  canonicalUrl,
  noIndex,
  type = 'website',
  publishedDate,
} = Astro.props;

const ogTitle = title;
const siteUrl = 'https://REPLACE-WITH-FINAL-DOMAIN.dev';
const ogImageUrl = ogImage ? new URL(ogImage, siteUrl).toString() : `${siteUrl}/og-default.png`;
const canonical = canonicalUrl ?? Astro.url.pathname;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content={type} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:url" content={canonical} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
{noIndex && <meta name="robots" content="noindex" />}
{publishedDate && <meta property="article:published_time" content={publishedDate} />}

<script type="application/ld+json" is:inline set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Vincent Boetzel',
  alternateName: 'vindows',
  jobTitle: 'Backend & Infrastructure Engineer',
  url: siteUrl,
  sameAs: [
    'https://github.com/vindows',
    'https://linkedin.com/in/vindows',
  ],
})} />
