---
import { localizedUrl, type Locale } from '@/i18n';

export interface Props {
  title: string;
  description: string;
  locale?: Locale;
  ogImage?: string;
  canonicalUrl?: string;
  noIndex?: boolean;
  type?: 'website' | 'article';
  publishedDate?: string;
}

const {
  title,
  description,
  locale = 'en',
  ogImage,
  canonicalUrl,
  noIndex,
  type = 'website',
  publishedDate,
} = Astro.props;

const ogTitle = title;
const siteUrl = 'https://REPLACE-WITH-FINAL-DOMAIN.dev';
const ogImageUrl = ogImage ? new URL(ogImage, siteUrl).toString() : undefined;
const currentPath = Astro.url.pathname;
const canonical = canonicalUrl ?? (siteUrl + currentPath);
const enPath = locale === 'de' ? localizedUrl(currentPath, 'en') : currentPath;
const dePath = locale === 'en' ? localizedUrl(currentPath, 'de') : currentPath;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<link rel="alternate" hreflang="en" href={siteUrl + enPath} />
<link rel="alternate" hreflang="de" href={siteUrl + dePath} />

<meta property="og:type" content={type} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={description} />
{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
<meta property="og:url" content={canonical} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={description} />
{ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
{noIndex && <meta name="robots" content="noindex" />}
{publishedDate && <meta property="article:published_time" content={publishedDate} />}

<script type="application/ld+json" is:inline set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Vincent Boetzel',
  alternateName: 'vindows',
  jobTitle: 'Backend & Infrastructure Engineer',
  url: siteUrl,
  sameAs: [
    'https://github.com/vindows',
    'https://linkedin.com/in/vindows',
  ],
})} />
