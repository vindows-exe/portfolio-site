---
import { NAV_ITEMS } from '@/config/constants';
import { SITE } from '@/data/site';
import { t, type Locale } from '@/i18n';

export interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<header
  class="border-border bg-canvas/95 relative sticky top-0 z-40 border-b backdrop-blur-sm"
>
  <nav
    class="max-w-shell mx-auto flex items-center justify-between px-4 py-3"
    aria-label="Main navigation"
  >
    <a
      href={locale === 'de' ? '/de' : '/'}
      class="text-text-primary hover:text-accent font-mono text-sm font-medium transition-colors"
      aria-label="Home"
    >
      {SITE.handle}
    </a>

    <!-- Right side: nav (desktop) + lang + theme + hamburger -->
    <div class="ml-auto flex items-center gap-1">
      <div class="hidden items-center gap-1 md:flex">
        {
          NAV_ITEMS.map((item) => (
            <a
              href={locale === 'de' ? '/de' + item.href : item.href}
              class="text-text-secondary hover:text-text-primary hover:bg-surface-raised shrink-0 rounded-md px-3 py-1.5 font-mono text-sm transition-colors"
            >
              {t(locale, item.labelKey)}
            </a>
          ))
        }
      </div>

      <div class="border-border flex items-center gap-0.5 border-l pl-2">
        <button
          id="lang-en"
          class={`cursor-pointer px-1.5 py-0.5 text-xs font-mono rounded transition-colors ${locale === 'en' ? 'text-accent bg-accent-subtle' : 'text-text-tertiary hover:text-text-secondary'}`}
          aria-label="Switch to English">EN</button
        >
        <button
          id="lang-de"
          class={`cursor-pointer px-1.5 py-0.5 text-xs font-mono rounded transition-colors ${locale === 'de' ? 'text-accent bg-accent-subtle' : 'text-text-tertiary hover:text-text-secondary'}`}
          aria-label="Switch to German">DE</button
        >
        <button
          id="theme-toggle"
          class="text-text-secondary hover:text-text-primary hover:bg-surface-raised ml-1.5 rounded-md px-2 py-1.5 font-mono text-sm transition-colors"
          aria-label="Toggle theme"
        >
          <span id="theme-icon-light" aria-hidden="true">&#9788;</span>
          <span id="theme-icon-dark" aria-hidden="true" class="hidden"
            >&#9790;</span
          >
        </button>
        <button
          id="menu-toggle"
          class="text-text-secondary hover:text-text-primary hover:bg-surface-raised ml-1.5 rounded-md px-2 py-1.5 text-sm transition-colors md:hidden"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <span id="menu-icon-open">☰</span>
          <span id="menu-icon-close" class="hidden">✕</span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile dropdown (overlay under header) -->
  <div
    id="mobile-menu"
    class="border-border bg-canvas/95 absolute top-full right-0 left-0 hidden border-b shadow-lg backdrop-blur-sm md:hidden"
  >
    <div class="flex flex-col gap-1 px-4 py-3">
      {
        NAV_ITEMS.map((item) => (
          <a
            href={locale === 'de' ? '/de' + item.href : item.href}
            class="text-text-secondary hover:text-text-primary hover:bg-surface-raised block rounded-md px-3 py-2 font-mono text-sm transition-colors"
          >
            {t(locale, item.labelKey)}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('theme-toggle');
  const lightIcon = document.getElementById('theme-icon-light');
  const darkIcon = document.getElementById('theme-icon-dark');
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuOpen = document.getElementById('menu-icon-open');
  const menuClose = document.getElementById('menu-icon-close');

  function updateIcons(theme: string) {
    const isDark = theme === 'dark';
    lightIcon?.classList.toggle('hidden', isDark);
    darkIcon?.classList.toggle('hidden', !isDark);
  }

  updateIcons(
    document.documentElement.classList.contains('dark') ? 'dark' : 'light',
  );

  toggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    const newTheme = isDark ? 'light' : 'dark';
    document.documentElement.classList.toggle('dark', !isDark);
    document.documentElement.style.colorScheme = newTheme;
    localStorage.setItem('theme', newTheme);
    updateIcons(newTheme);
  });

  menuToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden') === false;
    menuToggle.setAttribute('aria-expanded', String(isOpen));
    menuOpen?.classList.toggle('hidden', isOpen);
    menuClose?.classList.toggle('hidden', !isOpen);
  });

  function switchLang(to: string) {
    const path = window.location.pathname;
    const suffix = window.location.search + window.location.hash;
    if (to === 'en' && path.startsWith('/de')) {
      sessionStorage.setItem('lang-switch-pos', window.scrollY.toString());
      localStorage.setItem('lang', 'en');
      window.location.href = path.replace(/^\/de/, '') || '/' + suffix;
    } else if (to === 'de' && !path.startsWith('/de')) {
      sessionStorage.setItem('lang-switch-pos', window.scrollY.toString());
      localStorage.setItem('lang', 'de');
      window.location.href = '/de' + path + suffix;
    }
  }
  document
    .getElementById('lang-en')
    ?.addEventListener('click', () => switchLang('en'));
  document
    .getElementById('lang-de')
    ?.addEventListener('click', () => switchLang('de'));
</script>
