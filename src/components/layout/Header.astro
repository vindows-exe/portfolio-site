---
import { NAV_ITEMS } from '@/config/constants';
import { t, localizedUrl, type Locale } from '@/i18n';

export interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-border bg-canvas/95 backdrop-blur-sm">
  <nav class="mx-auto flex max-w-shell items-center justify-between px-4 py-3" aria-label="Main navigation">
    <a href="/" class="font-mono text-sm font-medium text-text-primary hover:text-accent transition-colors" aria-label="Home">
      vindows
    </a>

    <div class="flex items-center gap-1">
      {NAV_ITEMS.map((item) => (
        <a
          href={item.href}
          class="px-3 py-1.5 text-sm font-mono rounded-md transition-colors text-text-secondary hover:text-text-primary hover:bg-surface-raised"
        >
          {t(locale, item.labelKey)}
        </a>
      ))}

      <div class="flex items-center gap-0.5 ml-2 border-l border-border pl-2">
        <a
          href={locale === 'de' ? localizedUrl(currentPath, 'en') : '#'}
          class={`px-1.5 py-0.5 text-xs font-mono rounded transition-colors ${locale === 'en' ? 'text-accent bg-accent-subtle' : 'text-text-tertiary hover:text-text-secondary'}`}
          aria-label="Switch to English"
        >EN</a>
        <a
          href={locale === 'en' ? localizedUrl(currentPath, 'de') : '#'}
          class={`px-1.5 py-0.5 text-xs font-mono rounded transition-colors ${locale === 'de' ? 'text-accent bg-accent-subtle' : 'text-text-tertiary hover:text-text-secondary'}`}
          aria-label="Switch to German"
        >DE</a>
      </div>

      <button
        id="theme-toggle"
        class="ml-2 rounded-md px-2 py-1.5 text-sm font-mono text-text-secondary hover:text-text-primary hover:bg-surface-raised transition-colors"
        aria-label="Toggle theme"
      >
        <span id="theme-icon-light" aria-hidden="true">&#9788;</span>
        <span id="theme-icon-dark" aria-hidden="true" class="hidden">&#9790;</span>
      </button>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('theme-toggle');
  const lightIcon = document.getElementById('theme-icon-light');
  const darkIcon = document.getElementById('theme-icon-dark');

  function updateIcons(theme: string) {
    const isDark = theme === 'dark';
    lightIcon?.classList.toggle('hidden', isDark);
    darkIcon?.classList.toggle('hidden', !isDark);
  }

  updateIcons(document.documentElement.classList.contains('dark') ? 'dark' : 'light');

  toggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    const newTheme = isDark ? 'light' : 'dark';
    document.documentElement.classList.toggle('dark', !isDark);
    document.documentElement.style.colorScheme = newTheme;
    localStorage.setItem('theme', newTheme);
    updateIcons(newTheme);
  });
</script>
