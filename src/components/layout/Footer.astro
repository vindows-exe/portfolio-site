---
import { SITE } from '@/data/site';
import Container from '@/components/ui/Container.astro';
import Divider from '@/components/ui/Divider.astro';
---

<footer class="py-12">
  <Container>
    <Divider class="mb-8" />
    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
      <div class="flex items-center gap-4">
        {SITE.socials.map((social) => (
          <a
            href={social.url}
            class="text-sm font-mono text-text-tertiary hover:text-accent transition-colors"
            aria-label={social.label}
            target="_blank"
            rel="noopener noreferrer"
          >
            {social.name}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-2 text-xs text-text-tertiary">
        <span>&copy; {new Date().getFullYear()} {SITE.name}</span>
        <span aria-hidden="true">&middot;</span>
        <span class="font-mono">Built with <a href="https://astro.build" class="hover:text-accent transition-colors" target="_blank" rel="noopener noreferrer">Astro</a></span>
      </div>
    </div>
  </Container>
</footer>
