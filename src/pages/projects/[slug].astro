---
import { getCollection, type CollectionEntry } from 'astro:content';
import ProjectLayout from '@/layouts/ProjectLayout.astro';

export async function getStaticPaths() {
  const projects: CollectionEntry<'projects'>[] = await getCollection('projects', ({ id }: { id: string }) => id.startsWith('en/'));
  return projects.map((project: CollectionEntry<'projects'>) => ({
    params: { slug: project.slug.replace(/^en\//, '') },
    props: { project },
  }));
}

const { project } = Astro.props as { project: CollectionEntry<'projects'> };
const { Content } = await project.render();
---

<ProjectLayout project={project}>
  <Content />
</ProjectLayout>
