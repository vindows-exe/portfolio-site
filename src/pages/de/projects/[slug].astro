---
import { getCollection, type CollectionEntry } from 'astro:content';
import ProjectLayout from '@/layouts/ProjectLayout.astro';
import { type Locale } from '@/i18n';

const locale: Locale = 'de';

export async function getStaticPaths() {
  const projects: CollectionEntry<'projects'>[] = await getCollection('projects', ({ id }: { id: string }) => id.startsWith('de/'));
  return projects.map((project: CollectionEntry<'projects'>) => ({
    params: { slug: project.slug.replace(/^de\//, '') },
    props: { project },
  }));
}

const { project } = Astro.props as { project: CollectionEntry<'projects'> };
const { Content } = await project.render();
---

<ProjectLayout project={project} locale={locale}>
  <Content />
</ProjectLayout>
