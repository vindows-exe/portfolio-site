---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const posts: CollectionEntry<'blog'>[] = (await getCollection('blog', ({ id }: { id: string }) => id.startsWith('en/')))
  .filter((p: CollectionEntry<'blog'>) => !p.data.draft)
  .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout title="Blog — Vincent Boetzel" description="Thoughts on backend engineering, infrastructure, and system design.">
  <Container class="py-16 md:py-24">
    <h1 class="text-display font-semibold text-text-primary mb-10">Blog</h1>

    {posts.length > 0 ? (
      <div class="space-y-6">
        {posts.map((post: CollectionEntry<'blog'>) => (
          <a href={`/blog/${post.slug.replace(/^en\//, '')}`} class="block rounded-lg border border-border bg-surface p-6 transition-colors hover:border-accent/30 hover:bg-surface-raised group">
            <div class="flex flex-col gap-2">
              <div class="flex items-center gap-3 text-xs font-mono text-text-tertiary">
                <time datetime={post.data.publishedAt.toISOString()}>
                  {post.data.publishedAt.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                {post.data.tags && post.data.tags.length > 0 && (
                  <span class="flex gap-1.5">
                    {post.data.tags.map((tag: string) => (
                      <span class="rounded bg-surface-raised px-1.5 py-0.5">{tag}</span>
                    ))}
                  </span>
                )}
              </div>
              <h2 class="text-xl font-semibold text-text-primary group-hover:text-accent transition-colors">
                {post.data.title}
              </h2>
              <p class="text-sm text-text-secondary leading-relaxed">{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-text-secondary font-mono text-sm">No posts yet.</p>
    )}
  </Container>
</BaseLayout>
