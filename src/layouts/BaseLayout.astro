---
import ThemeScript from '@/components/layout/ThemeScript.astro';
import LangScript from '@/components/layout/LangScript.astro';
import SEOHead from '@/components/layout/SEOHead.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import '@/styles/global.css';
import type { Locale } from '@/i18n';

export interface Props {
  title: string;
  description: string;
  locale?: Locale;
  ogImage?: string;
  canonicalUrl?: string;
  noIndex?: boolean;
  type?: 'website' | 'article';
  publishedDate?: string;
}

const {
  title,
  description,
  locale = 'en',
  ogImage,
  canonicalUrl,
  noIndex,
  type,
  publishedDate,
} = Astro.props;
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <LangScript />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <script>
      window.addEventListener('load', () => {
        const pos = sessionStorage.getItem('lang-switch-pos');
        if (pos !== null) {
          sessionStorage.removeItem('lang-switch-pos');
          window.scrollTo(0, parseInt(pos, 10));
        }
      });
    </script>
    <SEOHead
      title={title}
      description={description}
      locale={locale}
      ogImage={ogImage}
      canonicalUrl={canonicalUrl}
      noIndex={noIndex}
      type={type}
      publishedDate={publishedDate}
    />
    <slot name="head" />
  </head>
  <body class="bg-canvas text-text-primary font-sans antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-black focus:rounded">
      Skip to content
    </a>
    <Header locale={locale} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
